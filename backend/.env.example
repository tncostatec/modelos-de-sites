# Copie para .env. Nenhuma variável é obrigatória para rodar local.
# Para onde repassar cada lead/agendamento (webhook do n8n, Make, CRM). Vazio = só grava no banco.
WEBHOOK_URL=
# Sites autorizados a chamar a API pelo navegador, separados por vírgula. "*" só em demonstração.
ALLOWED_ORIGINS=https://www.exemplo.com.br
# Agenda: dias ISO (1=seg … 7=dom), janela, passo e antecedência mínima (minutos)
AGENDA_DIAS=1,2,3,4,5
AGENDA_INICIO=09:00
AGENDA_FIM=18:00
AGENDA_PASSO=30
AGENDA_ANTECEDENCIA=60
# Escritas por IP por hora (0 desliga)
RATE_LIMIT=30
# Prefixo do protocolo mostrado ao visitante
PROTOCOLO_PREFIXO=MD
